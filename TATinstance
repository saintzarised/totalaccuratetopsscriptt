local function OYJHOSK_fake_script() -- Button4.LocalScript 
	local script = Instance.new('LocalScript', Button4)

	local button = script.Parent
	local player = game.Players.LocalPlayer
	
	local toggled = false
	local originalColor = button.BackgroundColor3
	
	local trashFolder = workspace:WaitForChild("Map"):WaitForChild("Environment"):WaitForChild("Trash")
	
	local function autoCollect()
		while toggled do
			local character = player.Character
			if not character then
				task.wait(0.1)
				continue
			end
	
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if not hrp then
				task.wait(0.1)
				continue
			end
	
			for _, part in ipairs(trashFolder:GetChildren()) do
				if not toggled then break end
	
				if part:IsA("BasePart") then
					hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
				end
	
				task.wait(0.4)
				if not toggled then break end
	
				local prompt = part:FindFirstChildWhichIsA("ProximityPrompt", true)
				if prompt then
					prompt:InputHoldBegin()
	
					task.wait((prompt.HoldDuration or 0.1) + 0.9)
					if not toggled then break end
	
					prompt:InputHoldEnd()
				end
	
				task.wait(0.4)
			end
	
			task.wait(0.2)
		end
	end
	
	button.MouseButton1Click:Connect(function()
		toggled = not toggled
	
		if toggled then
			button.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
			task.spawn(autoCollect)
		else
			button.BackgroundColor3 = originalColor
		end
	end)
	
end
coroutine.wrap(OYJHOSK_fake_script)()
local function ASZNVHH_fake_script() -- Button5.LocalScript 
	local script = Instance.new('LocalScript', Button5)

	local button = script.Parent
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	
	button.MouseButton1Click:Connect(function()
		local character = player.Character or player.CharacterAdded:Wait()
		local hrp = character:WaitForChild("HumanoidRootPart")
	
		local mapFolder = workspace:FindFirstChild("Map")
		if not mapFolder then return end
	
		local meteorsFolder = mapFolder:FindFirstChild("Meteors")
		if not meteorsFolder then return end
	
		for _, meteor in ipairs(meteorsFolder:GetChildren()) do
			if meteor:IsA("Model") and meteor.Name == "Meteor" then
	
				local core = meteor:FindFirstChild("Core")
				if core and core:IsA("BasePart") then
	
					hrp.CFrame = CFrame.new(core.Position)
	
					return
				end
			end
		end
	end)
	
end
